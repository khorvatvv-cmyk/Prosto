{
  "name": "bit-support",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "test": "npm --prefix server test",
    "test:access": "node --test src/access.test.js",
    "test:worker": "node --test --test-isolation=none worker/*.test.js",
    "build:android:web": "vite build --mode android",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "cf:dev": "npm run build && wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply prosto-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply prosto-db --remote",
    "cf:deploy": "npm run build && npm run cf:migrate:remote && wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "lucide-react": "^1.28.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
